# Traffic captures and extracted app bundles can contain session tokens
# and third-party code. Keep them out of git.
captures/
extracted/
*.har
*.saz
*.asar

# Credentials and API tokens. Never commit a Descript bearer token.
.env
.env.*
*.pem
*.key
credentials/
secrets/
*token*.json
*credentials*

# Arcade RE: raw bundles, CRX contents and Wakaru output stay local.
arcade-rea-research/
raw/
recovered/
*.crx
*.zip
*.wasm
*.map
